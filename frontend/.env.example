# Copy to frontend/.env and fill in for local development.
# Only VITE_-prefixed variables are bundled into the browser build.
# They are NOT secrets. Never put backend secrets here.

# Base URL of the IRIS FastAPI backend (backend/app/main.py).
VITE_API_URL=http://localhost:8000

# Supabase project URL and anon key.
# The anon key is PUBLIC by design — it is safe to include here.
# The anon key grants only auth operations (sign-in, sign-up, OAuth).
# All data access goes through the IRIS backend API using the Bearer token.
# NEVER put the Supabase service-role key here — that belongs in backend/.env only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
