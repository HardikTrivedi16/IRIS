# IRIS backend configuration — copy to backend/.env and fill in.
# backend/.env is git-ignored. NEVER commit real values (especially the service-role key).
# Variable names are read by backend/app/config.py and backend/app/modules/ai/config.py.

# --- Supabase (real persistence + auth) -------------------------------------
# Server-side only. The service-role key bypasses RLS: never expose it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SCHEMA=public
# Optional: legacy HS256 projects only. Default verification uses the project's JWKS.
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Runtime -----------------------------------------------------------------
# Must be false anywhere real data is used. When true and Supabase is unset, auth is bypassed with a demo user.
IRIS_DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# --- Data roots (relative to backend/) -----------------------------------------
REGULATORY_DATA_ROOT=regulatory-data
SCHEME_DATA_ROOT=scheme-data

# --- Local AI (Ollama) ---------------------------------------------------------
IRIS_AI_ENABLED=true
IRIS_OLLAMA_URL=http://localhost:11434
IRIS_GENERATION_MODEL=qwen3:8b
IRIS_FALLBACK_MODEL=qwen3:4b
IRIS_EMBEDDING_MODEL=qwen3-embedding:0.6b
# IRIS_AI_TIMEOUT_SECONDS=300
# IRIS_AI_MAX_RETRIES=1

# --- OCR ------------------------------------------------------------------------
# Optional path to the Tesseract executable if it is not on PATH.
# IRIS_TESSERACT_CMD=

# --- Optional verifier (off by default) ------------------------------------------
# IRIS_VERIFIER_ENABLED=false
# IRIS_VERIFIER_PROVIDER=none
# GROQ_API_KEY=your-groq-api-key
